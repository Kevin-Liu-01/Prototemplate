#!/bin/sh
# Runs the public scan (pnpm lint:public) before a push and stops the push on
# any finding: a key shape, a machine path or, with PT_DENYLIST set to the
# private term list, a denylist term. It blocks since the switch (system v2,
# lane L7, 2026-10-10); before that it only reported.
# Enable it once per clone: git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)" || exit 1
if ! node "$root/scripts/lint/public.mjs"; then
  echo "pre-push: lint:public failed; the push is stopped. Fix each finding above (or add a file that must spell a pattern to scripts/lint/public.allow.json) and push again."
  exit 1
fi
exit 0
