      "hsl": [
        0,
        0,
        3
      ],
      "oklch": {
        "l": 0.1286,
        "c": 0,
        "h": 0,
        "css": "oklch(12.86% 0.0000 0)"
      },
      "role": "The logo and text on paper; the dark ground"
    },
    {
      "id": "raised-ink",
