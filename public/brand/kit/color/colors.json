{
  "name": "General Translation colours",
  "rules": [
    "Four absolute colours (ink, raised ink, titanium, paper) and one accent.",
    "The accent is #2f5ce0 on paper and its lift #86a8ff on ink; never #2f5ce0 on ink.",
    "The logo is always one colour: ink on paper, paper on ink, accent on paper, or accent lift on ink.",
    "The accent marks small elements only and never fills a large area."
  ],
  "colors": [
