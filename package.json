{
  "name": "prototemplate",
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3005",
    "build": "node scripts/lint/public.mjs --keys && node scripts/lint/pictures.mjs && node scripts/lint/type.mjs && node scripts/lint/radius.mjs && node scripts/lint/heads.mjs && node scripts/build/updated.mjs --check && next build",
    "start": "next start",
    "lint:shell": "node scripts/lint/shell.mjs",
    "lint:practices": "node scripts/lint/practices.mjs",
    "lint:lines": "node scripts/lint/lines.mjs",
    "lint:lines:shell": "node scripts/lint/lines.mjs --shell",
    "lint:code": "oxlint",
    "lint:pictures": "node scripts/lint/pictures.mjs",
    "test:pictures": "node --test scripts/lint/pictures.test.mjs",
    "lint:type": "node scripts/lint/type.mjs",
    "lint:type:live": "node scripts/lint/type.mjs --live",
    "test:type": "node --test scripts/lint/type.test.mjs",
    "lint:radius": "node scripts/lint/radius.mjs",
    "lint:radius:live": "node scripts/lint/radius.mjs --live",
    "test:radius": "node --test scripts/lint/radius.test.mjs",
    "lint:heads": "node scripts/lint/heads.mjs",
    "lint:heads:live": "node scripts/lint/heads.mjs --live",
    "test:heads": "node --test scripts/lint/heads.test.mjs",
    "mood-tone": "node scripts/media/mood-tone/mood-tone.mjs",
    "build:deck": "node scripts/build/deck.mjs",
    "build:marks": "node scripts/build/speed-marks.mjs",
    "build:inter": "python3 scripts/build/subset-inter.py",
    "build:thumbs": "node scripts/build/thumbs.mjs",
    "build:skills": "node scripts/build/skills.mjs",
    "lint:skills": "node scripts/build/skills.mjs --check",
    "lint:registries": "node scripts/lint/registries.mjs",
    "skills:install": "node scripts/skills/install.mjs",
    "test:skills": "node --test scripts/skills/install.test.mjs scripts/skills/script-tests.test.mjs scripts/build/skills.test.mjs",
    "build:motion": "node scripts/build/motion.mjs",
    "build:updated": "node scripts/build/updated.mjs",
    "lint:updated": "node scripts/build/updated.mjs --check",
    "test:updated": "node --test scripts/build/updated.test.mjs",
    "gen:all": "node scripts/build/gen-all.mjs",
    "capture:pages": "node scripts/check/capture-pages.mjs",
    "check:pages": "node scripts/check/pagecheck/pagecheck.mjs",
    "lint:copies": "node scripts/lint/copies.mjs",
    "test:copies": "node --test scripts/lint/copies.test.mjs",
    "lint:public": "node scripts/lint/public.mjs",
    "test:public": "node --test scripts/lint/public.test.mjs",
    "build:tools": "node scripts/build/tools.mjs",
    "lint:tools": "node scripts/build/tools.mjs --check",
    "skills:usage": "node scripts/skills/usage.mjs",
    "skills:stale": "node scripts/skills/usage.mjs --stale",
    "test:skill-scripts": "node scripts/skills/script-tests.mjs",
    "doctor": "node scripts/doctor.mjs",
    "lint:static": "pnpm lint:shell && pnpm lint:practices && pnpm lint:type && pnpm lint:radius && pnpm lint:heads && pnpm lint:skills && pnpm lint:registries && pnpm lint:updated && pnpm lint:tools && pnpm lint:copies && pnpm lint:public && pnpm lint:code && pnpm lint:pictures && pnpm test:pictures && pnpm test:type && pnpm test:radius && pnpm test:heads && pnpm test:updated && pnpm test:skills && pnpm test:copies && pnpm test:public && pnpm test:skill-scripts",
    "lint:all": "pnpm lint:static && pnpm lint:lines:shell && pnpm lint:type:live && pnpm lint:radius:live && pnpm lint:heads:live",
    "graphics:serve": "node graphics/serve/server.js graphics",
    "graphics:gen": "node graphics/build/gen-visuals.js",
    "graphics:render": "graphics/build/render.sh",
    "graphics:export": "python3 graphics/build/export-blog.py",
    "graphics:audit": "node graphics/build/audit.js"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@heroicons/react": "^2.2.0",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flag-icons": "^7.5.0",
    "franc": "^6.2.0",
    "gsap": "^3.13.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.27.0",
    "next": "^16.2.10",
    "next-mdx-remote": "^6.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "24.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "fontkit": "^2.0.4",
    "heroicons": "^2.2.0",
    "oxlint": "1.74.0",
    "playwright-core": "^1.62.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.2"
  }
}
